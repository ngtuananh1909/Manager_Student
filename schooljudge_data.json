      "sampleCode": "#include <iostream>\n#include <cstdio>\nusing namespace std;\n\nint main() {\n    // Hỗ trợ cả freopen(\"lucky.inp\", \"r\", stdin) hoặc cin/cout:\n    ios_base::sync_with_stdio(false);\n    cin.tie(NULL);\n    \n    // Viết lời giải bài LUCKY tại đây\n    \n    return 0;\n}\n",
