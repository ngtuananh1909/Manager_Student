{
  "name": "chaucaojudge",
  "version": "1.2.4",
  "description": "ChauCaoJudge - C++ Online Judge Trường Học",
  "main": "electron/main.cjs",
  "scripts": {
    "server": "node server/index.cjs",
    "dev:ui": "vite",
    "dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI\" -c \"cyan,magenta\" \"node server/index.cjs\" \"vite\"",
    "electron:dev": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI,APP\" -c \"cyan,magenta,green\" \"node server/index.cjs\" \"vite\" \"wait-on http://localhost:5173 && electron electron/main.cjs\"",
    "build": "vite build",
    "build:exe": "vite build && electron-builder --win --x64",
    "build:portable": "vite build && electron-builder --win portable --x64",
    "dist": "vite build && electron-builder --win --x64",
    "preview": "vite preview",
    "start": "concurrently -k -p \"[{name}]\" -n \"SERVER,UI\" -c \"cyan,magenta\" \"node server/index.cjs\" \"vite preview\"",
    "test": "node --test tests/*.test.cjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src server electron tests",
    "sign:update": "node scripts/sign-update.cjs"
  },
  "build": {
    "appId": "com.chaucaojudge.lan",
    "productName": "ChauCaoJudge",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "server/**/*",
      "config/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "artifactName": "${productName}_Setup_${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "argon2": "0.45.1",
    "canvas-confetti": "^1.9.4",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dompurify": "3.4.16",
    "express": "^5.2.1",
    "lucide-react": "^1.48.0",
    "mammoth": "^1.13.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sanitize-html": "2.18.0",
    "socket.io": "^4.8.4",
    "socket.io-client": "^4.8.4",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^26.6.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sanitize-html": "2.16.2",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "cross-env": "^10.1.0",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "oxlint": "1.86.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "wait-on": "^9.1.0"
  },
  "allowScripts": {
    "argon2@0.45.1": true
  }
}
